# Ignore cloned target repositories and scratch files in root (prefer cloning into work/)
/*

# Track repository root metadata, CI, and validation scripts
!/.gitignore
!/.github/
!/AGENTS.md
!/LICENSE
!/README.md
!/Makefile
!/TODO.md
!/scripts/

# Automatically track all skills (each self-contained with SKILL.md and assets/)
!/*-updater/
!/issue-triage/

# Ignore OS and tool artifacts anywhere inside tracked directories
.DS_Store
__pycache__/
*.pyc
